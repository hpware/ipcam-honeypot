# Copy to .env and tweak. Bun auto-loads .env

# Which endpoints to serve: both | dlink | pelco
# (the real DCS-2130 / IDE10DN run the same OEM firmware, so "both" serves
# the D-Link UI plus the Pelco alias endpoints on one HTTP port)
PERSONAS=both

BIND_HOST=0.0.0.0
HTTP_PORT=8080
RTSP_PORT=8554
TELNET_PORT=2323
# To mimic the real device 1:1 (nmap shows "Boa HTTPd 0.94.14rc21" on 80 and
# "D-Link DCS-2130 or Pelco IDE10DN webcam rtspd" on 554) run as root with:
#   HTTP_PORT=80 RTSP_PORT=554

# Grafana Loki push API
LOKI_URL=http://127.0.0.1:3100
# X-Scope-OrgID header, only needed for multi-tenant Loki setups
# LOKI_TENANT_ID=
LOKI_JOB=ipcam-honeypot

# Local NDJSON backup (always written, even if Loki is down)
LOG_FILE=logs/honeypot.ndjson
# 0 = one line per event on stdout, 1 = also dump headers/bodies
VERBOSE=0
